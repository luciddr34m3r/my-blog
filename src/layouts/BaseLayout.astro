---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="bg-slate-950 text-slate-200 antialiased min-h-screen flex flex-col selection:bg-teal-500 selection:text-white">
		<Header />
		<main class="flex-grow w-full max-w-4xl mx-auto px-4 md:px-0 py-8">
			<slot />
		</main>
		<Footer />
	</body>
</html>
