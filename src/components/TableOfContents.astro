---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const filteredHeadings = headings.filter((heading) => heading.depth <= 3);
---

<nav class="toc">
  <h2 class="text-sm font-bold text-slate-200 uppercase tracking-wider mb-4">Table of Contents</h2>
  <ul class="space-y-2 text-sm">
    {filteredHeadings.map((heading) => (
      <li class={`toc-level-${heading.depth} pl-${(heading.depth - 2) * 4}`}>
        <a href={`#${heading.slug}`} class="text-slate-400 hover:text-teal-400 transition-colors block border-l-2 border-transparent hover:border-teal-400 pl-2 -ml-[2px]">
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
