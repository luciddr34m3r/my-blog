---
const today = new Date();
---

<footer class="bg-slate-950 border-t border-slate-900 text-slate-500 py-8 mt-12">
  <div class="max-w-4xl mx-auto px-4 md:px-0 flex flex-col md:flex-row justify-between items-center text-sm font-mono">
    <div class="mb-4 md:mb-0">
      &copy; {today.getFullYear()} Security Researcher. All rights reserved.
    </div>
    <div class="flex gap-4">
      <a href="https://github.com" target="_blank" class="hover:text-teal-400 transition-colors">GitHub</a>
      <a href="https://twitter.com" target="_blank" class="hover:text-teal-400 transition-colors">Twitter/X</a>
    </div>
  </div>
</footer>
