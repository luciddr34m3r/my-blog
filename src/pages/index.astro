---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3); // Latest 3 posts

const title = "Security Research & Engineering";
const description = "Observations on vulnerability research, AI safety, and offensive security.";
---

<BaseLayout title={`Home | ${title}`} description={description}>
  <section class="py-12 md:py-20">
    <div class="max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">
        Defensive security through <span class="text-teal-400">offensive insight</span>.
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed mb-8">
        I research vulnerability classes, analyze AI safety failures, and write about the intersection of national policy and technical reality.
      </p>
      <div class="flex gap-4">
        <a href="/blog" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-slate-950 bg-teal-400 hover:bg-teal-300 transition-colors">
          Read the Blog
        </a>
        <a href="/about" class="inline-flex items-center justify-center px-6 py-3 border border-slate-700 text-base font-medium rounded-md text-slate-200 hover:bg-slate-800 transition-colors">
          About Me
        </a>
      </div>
    </div>
  </section>

  <section class="py-12 border-t border-slate-900">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold">Latest Transmissions</h2>
      <a href="/blog" class="text-sm font-mono text-teal-400 hover:text-teal-300">View all -></a>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </section>
</BaseLayout>
