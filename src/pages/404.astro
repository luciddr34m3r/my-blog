---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "404: Not Found";
const description = "The signal has been lost.";
---

<BaseLayout title={title} description={description}>
  <div class="flex flex-col items-center justify-center min-h-[50vh] text-center">
    <h1 class="text-6xl md:text-8xl font-bold font-mono text-teal-400 mb-4">404</h1>
    <h2 class="text-2xl md:text-3xl font-bold text-slate-200 mb-6">Signal Lost</h2>
    <p class="text-slate-400 max-w-md mb-8">
      The requested resource could not be found via the current vector. Check your syntax or return to base.
    </p>
    <a href="/" class="px-6 py-3 bg-slate-800 hover:bg-slate-700 text-teal-400 font-mono rounded transition-colors border border-slate-700">
      cd /home
    </a>
  </div>
</BaseLayout>
